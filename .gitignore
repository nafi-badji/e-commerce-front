# ============================================
# Fichiers à ignorer par Git
# ============================================

# Fichiers de configuration sensibles
config.php
database.php

# Fichiers uploadés par les utilisateurs
assets/uploads/*
!assets/uploads/.gitkeep

# Fichiers de logs
*.log

# Fichiers temporaires
*.tmp
*.temp
*.cache

# Fichiers système
.DS_Store
Thumbs.db
desktop.ini

# Fichiers d'éditeur
.vscode/
.idea/
*.swp
*.swo
*~

# Fichiers de sauvegarde
*.bak
*.backup
*~

# Fichiers de session PHP
sessions/
