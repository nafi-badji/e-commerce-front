# ============================================
# Configuration Apache pour E-Commerce
# ============================================

# Activer le moteur de réécriture
RewriteEngine On

# Base URL
RewriteBase /e-commerce-front/

# Protection contre les injections de fichiers
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Protection des fichiers sensibles
<FilesMatch "^(config|database|fonctions)\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Redirection vers index.php si le fichier n'existe pas
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?page=$1 [L,QSA]

# Sécurité : Désactiver l'affichage des répertoires
Options -Indexes

# Protection contre les attaques XSS
<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Compression GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache des fichiers statiques
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Encodage UTF-8
AddDefaultCharset UTF-8

# Limite de taille d'upload (si mod_php est utilisé)
php_value upload_max_filesize 10M
php_value post_max_size 10M

